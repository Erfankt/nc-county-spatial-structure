name: CI

on:
  push:
    branches: [main, master]
  pull_request:

jobs:
  python:
    name: App tests (pytest)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-dev.txt
      - run: pip install -r requirements-dev.txt
      - name: Guard against committed secrets (40-character hex strings, e.g. Census API keys)
        run: |
          if grep -rEn --include='*.R' --include='*.py' --include='*.md' --include='*.yml' --include='*.toml' \
               --exclude-dir=.git '(^|[^0-9a-fA-F])[0-9a-f]{40}([^0-9a-fA-F]|$)' .; then
            echo "Possible secret found"; exit 1
          fi
      - run: pytest -q tests

  r:
    name: Pipeline helper tests (testthat)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: System libraries for sf
        run: sudo apt-get update && sudo apt-get install -y libudunits2-dev libgdal-dev libgeos-dev libproj-dev
      - uses: r-lib/actions/setup-r@v2
        with:
          use-public-rspm: true
      - uses: r-lib/actions/setup-r-dependencies@v2
        with:
          packages: |
            any::sf
            any::dplyr
            any::tidyr
            any::purrr
            any::readr
            any::ggplot2
            any::jsonlite
            any::spdep
            any::spatialreg
            any::testthat
      - run: Rscript tests/testthat.R
